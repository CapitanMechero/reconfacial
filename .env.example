# Copia este archivo a .env (no versionado) si quieres cambiar algo. Nada es obligatorio:
# la clave HMAC de integridad se genera sola en el primer arranque (volumen facerec-state).

FACEREC_LOG_LEVEL=INFO

# Overrides de umbrales de identificación (vacío = data/thresholds.json o valores por defecto).
# Un override marca los umbrales como «no calibrados» en la interfaz.
FACEREC_T1=
FACEREC_T2=
